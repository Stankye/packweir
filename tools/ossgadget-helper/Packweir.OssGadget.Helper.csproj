<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>packweir-ossgadget-helper</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <Target Name="RequirePinnedUpstream" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(OssgadgetRoot)/.pins.json')" Text="Run provision.py and set -p:OssgadgetRoot to its absolute output directory." />
  </Target>
  <ItemGroup>
    <Reference Include="ApplicationInspector.Commands"><HintPath>$(OssgadgetRoot)/ApplicationInspector.Commands.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ApplicationInspector.RulesEngine"><HintPath>$(OssgadgetRoot)/ApplicationInspector.RulesEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>$(OssgadgetRoot)/Microsoft.Extensions.Logging.Abstractions.dll</HintPath><Private>false</Private></Reference>
    <EmbeddedResource Include="$(OssgadgetRoot)/.pins.json" LogicalName="UpstreamPins" />
    <Content Include="$(OssgadgetRoot)/**/*" Exclude="$(OssgadgetRoot)/.pins.json"><Link>upstream/%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
  </ItemGroup>
</Project>
